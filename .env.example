# Required. SQLite is suitable for a single-node deployment; use PostgreSQL
# for multiple API/worker/webhook replicas.
DATABASE_URL=sqlite:////app/data/noc_fusion.db

# Production defaults to no synthetic assets. Set true only in a disposable demo.
DEMO_SEED_DATA=false
DEFAULT_ADMIN_PASSWORD=change-me-before-first-start
LOG_LEVEL=INFO

RISK_ALERT_RECIPIENTS=
ELASTIC_URL=https://localhost:9200
ELASTIC_API_KEY=
CRIME_ALERT_SMS=
CRIME_ALERT_EMAIL=

# Optional SolarWinds webhook request signing.
WEBHOOK_HMAC_SECRET=
WEBHOOK_SIGNATURE_HEADER=X-SolarWinds-Signature
WEBHOOK_TIMESTAMP_HEADER=X-SolarWinds-Timestamp
WEBHOOK_REPLAY_WINDOW_SECONDS=300
WEBHOOK_MAX_BODY_BYTES=1048576
WEBSOCKET_MAX_MESSAGE_BYTES=65536
ALLOW_PRIVATE_LLM_ENDPOINTS=false
CORS_ORIGINS=http://localhost:8501,http://localhost:5173
ALLOW_UNSIGNED_WEBHOOKS=false
